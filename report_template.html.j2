<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>D1 Futsal — Rapport de match v3</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800;900&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --cream:#F3F1EA;
    --ink:#111111;
    --red:#EF3B30;
    --gray:#8A8A85;
    /* Couleurs équipe placeholder — à remplacer par les vraies couleurs de club */
    --team-a:#111111;   /* LAVAL */
    --team-b:#EF3B30;   /* NICE */
  }
  *{ box-sizing:border-box; }
  body{
    margin:0; background:#DEDAD0; font-family:'Poppins',sans-serif;
    display:flex; flex-direction:column; align-items:center; gap:28px; padding:28px 0;
  }
  .card{
    width:200mm; height:200mm;
    background:var(--cream);
    border:7px solid var(--ink);
    border-radius:22px;
    padding:10mm 11mm 8mm;
    position:relative;
    overflow:hidden;
  }
  .kicker{ color:var(--red); font-weight:800; font-size:16px; letter-spacing:0.3px; margin-bottom:6px; }
  .rule{ height:4px; background:var(--ink); border:none; margin:0 0 16px; }
  .title{ font-family:'Playfair Display','Lora',serif; font-weight:900; color:var(--ink); line-height:1.03; margin:0; }
  .footer{ position:absolute; left:11mm; right:11mm; bottom:8mm; padding-top:10px; border-top:4px solid var(--ink); display:flex; justify-content:space-between; align-items:baseline; }
  .footer .cap{ color:var(--gray); font-size:13px; }
  .footer .pg{ font-weight:800; font-size:16px; }

  /* ===== PAGE 1 : COVER ===== */
  .hero{ display:flex; margin:24px 0 0; }
  .hero .team{ width:50%; text-align:center; }
  .logo-slot{ width:180px; height:120px; margin:0 auto 18px; display:flex; align-items:center; justify-content:center; }
  .logo-slot img{ width:180px; height:120px; object-fit:contain; }
  .hero .tname{ font-family:'Playfair Display','Lora',serif; font-weight:800; line-height:1; color:var(--ink); white-space:nowrap; }
  .score-hero{ position:relative; display:flex; margin:12px 0 18px; }
  .score-hero .half{ width:50%; text-align:center; }
  .score-hero .digits{ font-family:'Playfair Display','Lora',serif; font-weight:900; font-size:112px; line-height:1; }
  .score-hero .sep{ position:absolute; left:50%; top:58%; width:56px; margin-left:-28px; height:12px; margin-top:-6px; background:var(--red); }
  .scorers{ display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); column-gap:18px; margin:0 0 6px; }
  .scorers .col{ text-align:center; }
  .scorers .liste{ display:inline-block; text-align:left; vertical-align:top; }
  .scorers .col h6{ margin:0 0 12px; font-size:19px; font-weight:800; letter-spacing:.3px; color:var(--ink); font-family:'Playfair Display','Lora',serif; }
  .scorers .goal{ display:flex; gap:14px; font-size:1em; white-space:nowrap; font-family:'Playfair Display','Lora',serif; padding:4px 0; }
  .scorers .goal .min{ font-weight:700; flex:0 0 46px; }
  .byline{ position:absolute; right:11mm; bottom:22mm; color:var(--red); font-weight:800; font-size:14px; }
  /* ===== PAGE 2 : STATS COLLECTIVES ===== */
  .stat-table{ width:100%; border-collapse:collapse; font-size:12px; margin-top:2px; }
  .stat-table td{ padding:2.5px 2px; border-bottom:1px solid #E2DECF; }
  .stat-table td.va{ width:110px; text-align:center; font-family:'Playfair Display','Lora',serif; font-weight:800; font-size:19px; line-height:1.15; color:var(--team-a); }
  .stat-table td.vb{ width:110px; text-align:center; font-family:'Playfair Display','Lora',serif; font-weight:800; font-size:19px; line-height:1.15; color:var(--team-b); }
  .stat-table td.lb{ text-align:center; font-size:13.5px; color:var(--ink); font-weight:600; }
  .stat-table tr.grp td{ padding-top:7px; padding-bottom:1px; font-weight:800; font-size:12px; color:var(--gray); text-transform:uppercase; border-bottom:none; text-align:center; letter-spacing:.4px; }

  .stat-table tr.eq td{ border-bottom:2px solid var(--ink); padding:2px 2px 5px; }
  .stat-table tr.eq td{ text-align:center; color:var(--ink); white-space:nowrap; }
  .stat-table tr.eq img{ height:20px; width:30px; object-fit:contain; vertical-align:middle; margin-left:6px; }
  .stat-table tr.eq span{ font-family:'Poppins',sans-serif; font-size:11px; font-weight:800; letter-spacing:.3px; vertical-align:middle; color:var(--ink); }
  .title-logo{ height:40px; width:60px; object-fit:contain; vertical-align:-10px; margin-right:12px; }
  .h6-logo{ height:28px; width:28px; object-fit:contain; vertical-align:-5px; margin-right:8px; }

  /* ===== PAGES JOUEURS (1 par équipe) ===== */
  .headline{ padding:16px 18px; color:#fff; margin-bottom:16px; }
  .headline.a{ background:var(--team-a); } .headline.b{ background:var(--team-b); }
  .headline .nm{ font-family:'Playfair Display','Lora',serif; font-weight:900; font-size:24px; }
  .headline .st{ font-size:12.5px; font-weight:600; margin-top:4px; opacity:.92; }

  table.pl2{ width:100%; border-collapse:collapse; font-size:14px; flex:1; }
  table.pl2 th{ font-weight:800; color:var(--gray); font-size:11px; text-transform:uppercase; letter-spacing:.2px; text-align:center; padding:4px 2px; }
  table.pl2 thead tr:first-child th{ border-bottom:1px solid #D9D5CA; padding-bottom:3px; }
  table.pl2 thead tr:last-child th{ border-bottom:2px solid var(--ink); padding-bottom:6px; }
  table.pl2 th:first-child, table.pl2 td:first-child{ text-align:left; }
  table.pl2 td{ text-align:center; padding:6.5px 2px; font-variant-numeric:tabular-nums; }
  table.pl2 td:first-child{ font-weight:700; font-size:14px; }
  table.pl2 tbody tr:nth-child(odd){ background:#EAE6D9; }
  table.pl2 td.duel{ width:74px; }
  .duelbar{ display:flex; height:13px; border-radius:2px; overflow:hidden; background:#D9D5CA; margin-bottom:2px; }
  .duelbar .win{ background:var(--ink); }
  .duelbar .lose{ background:#C7C2B3; }
  .duelbar.b .win{ background:var(--team-b); }
  .duel-txt{ font-size:9px; color:var(--gray); }

  /* ===== PAGE 6 : ORIGINES DES BUTS ===== */
  .goals-cols{ display:table; width:100%; table-layout:fixed; border-spacing:0; margin-top:14px; }
  .goals-col{ display:table-cell; vertical-align:top; width:50%; }
  .goals-col.a{ padding-right:5mm; }
  .goals-col.b{ padding-left:5mm; }
  .goals-col h6{ font-size:12px; font-weight:800; margin:0 0 8px; padding-bottom:6px; border-bottom:3px solid; }
  .goals-col.a h6{ color:var(--team-a); border-color:var(--team-a); }
  .goals-col.b h6{ color:var(--team-b); border-color:var(--team-b); }
  .goal-card{ border:1.5px solid var(--ink); border-radius:6px; padding:6px 10px; margin-bottom:6px; }
  .goal-card .row{ font-size:12.5px; }
  .goal-card .row b{ font-family:'Playfair Display','Lora',serif; font-size:14px; }
  .goal-card .origine{ font-size:10px; color:var(--gray); margin-top:1px; text-transform:capitalize; }

  /* ===== PAGE 5 : GARDIENS ===== */
  .gk-split{ display:table; width:100%; table-layout:fixed; }
  .gk-side{ display:table-cell; vertical-align:top; width:50%; }
  .gk-side.a{ padding-right:5mm; } .gk-side.b{ padding-left:5mm; }
  .gk-side h6{ font-family:'Playfair Display','Lora',serif; font-size:26px; font-weight:800; margin:0 0 8px;
    padding-bottom:8px; border-bottom:2px solid var(--ink); color:var(--ink); }
  .gk-box2{ border:2px solid var(--ink); border-radius:14px; padding:8px 14px; margin-bottom:7px; }
  .gk-box2 .nm{ font-family:'Playfair Display','Lora',serif; font-weight:800; font-size:18px; margin-bottom:4px; }
  .gk-box2 .grid2{ display:grid; grid-template-columns:1fr 1fr; gap:4px 10px; }
  .gk-box2 .grid2 div{ font-size:13px; display:flex; justify-content:space-between; }
  .gk-box2 .grid2 b{ font-size:15px; }
  .gk-box2 .relances{ margin-top:6px; padding-top:6px; border-top:1px dashed #C9C4B4; font-size:12px;
    color:var(--ink); text-align:center; line-height:1.25; }
  .gk-box2 .relances .lab{ font-weight:700; display:block; margin-bottom:1px; }
  .gk-box2 .relances.hors-cage{ margin-top:6px; padding-top:6px; }
  .gk-box2 .hc-grid{ display:grid; grid-template-columns:1fr 1fr; gap:2px 10px; margin-top:6px; padding-top:6px;
    border-top:1px dashed #C9C4B4; }
  .gk-box2 .hc-grid .hc-lab{ font-weight:700; font-size:12px; grid-column:1/3; text-align:center; margin-bottom:1px; }
  .gk-box2 .hc-grid div:not(.hc-lab){ font-size:11.5px; display:flex; justify-content:space-between; }
  .gk-box2 .hc-grid b{ font-size:12.5px; }
  /* 2 gardiens ou plus dans une équipe : cartes resserrées pour tenir sur la page */
  .gk-compact .gk-box2{ padding:5px 12px; margin-bottom:5px; }
  .gk-compact .gk-box2 .nm{ font-size:15px; margin-bottom:2px; }
  .gk-compact .gk-box2 .grid2{ gap:2px 10px; }
  .gk-compact .gk-box2 .grid2 div{ font-size:11.5px; }
  .gk-compact .gk-box2 .grid2 b{ font-size:13px; }
  .gk-compact .gk-box2 .relances{ font-size:10.5px; margin-top:4px; padding-top:4px; line-height:1.2; }
  .gk-compact .gk-box2 .hc-grid{ gap:1px 10px; margin-top:4px; padding-top:4px; }
  .gk-compact .gk-box2 .hc-grid .hc-lab{ font-size:10.5px; }
  .gk-compact .gk-box2 .hc-grid div:not(.hc-lab){ font-size:10.5px; }
  .gk-compact .gk-box2 .hc-grid b{ font-size:11.5px; }

  /* ===== FICHE DÉFINITIONS ===== */
  .def-group{ font-weight:800; font-size:11px; color:var(--gray); text-transform:uppercase;
    letter-spacing:.4px; margin:12px 0 4px; }
  .def-group:first-child{ margin-top:0; }
  .def-row{ font-size:11px; padding:4px 0; border-bottom:1px solid #E2DECF; line-height:1.35; }
  .def-row b{ font-weight:800; }
  .def-page{ font-size:11px; color:var(--gray); }

  @media print{
    body{ background:none; padding:0; gap:0; }
    .card{ box-shadow:none; page-break-after:always; margin:0 auto; }
    .card:last-child{ page-break-after:auto; }
  }
  @page{ size:200mm 200mm; margin:0; }
{% if story %}
  /* ===== FORMAT STORY INSTAGRAM 1080 x 1920 (9:16) : même largeur, page plus haute, tout agrandi ===== */
  @page{ size:200mm 355.56mm; margin:0; }
  .card{ height:355.56mm; padding:14mm 11mm 10mm; }
  .kicker{ font-size:22px; margin-bottom:10px; }
  .rule{ height:5px; margin-bottom:26px; }
  .title{ font-size:46px !important; margin-bottom:22px !important; }
  .footer{ bottom:10mm; padding-top:14px; }
  .footer .cap{ font-size:18px; } .footer .pg{ font-size:22px; }
  /* couverture */
  .hero{ margin:150px 0 0; }
  .logo-slot{ width:270px; height:180px; margin-bottom:30px; }
  .logo-slot img{ width:270px; height:180px; }
  .hero .tname{ font-size:{{ (tsize_story) }}px !important; }
  .score-hero{ margin:100px 0 100px; }
  .score-hero .digits{ font-size:210px; }
  .score-hero .sep{ width:80px; margin-left:-40px; height:16px; margin-top:-8px; }
  .scorers{ font-size:{{ 31 if ng_story <= 4 else (25 if ng_story <= 7 else 20) }}px !important; }
  .scorers .col h6{ font-size:24px; margin-bottom:18px; white-space:nowrap; }
  .scorers .goal{ gap:18px; padding:7px 0; }
  .scorers .goal .min{ flex:0 0 64px; }
  .byline{ font-size:20px; bottom:30mm; }
  /* stats collectives */
  .stat-table td{ padding:7.5px 2px; }
  .stat-table td.va, .stat-table td.vb{ font-size:31px; width:150px; }
  .stat-table td.lb{ font-size:19px; }
  .stat-table tr.grp td{ font-size:16px; padding-top:16px; padding-bottom:2px; }
  .stat-table tr.eq td{ padding:4px 2px 12px; }
  .stat-table tr.eq img{ height:30px; width:45px; }
  .stat-table tr.eq span{ font-size:16px; }
  .title-logo{ height:56px; width:84px; vertical-align:-12px; }
  /* feuilles joueurs */
  table.pl2{ font-size:17px; }
  table.pl2 th{ font-size:13px; padding:7px 2px; }
  table.pl2 td{ padding:{{ pad_story }}px 2px; }
  table.pl2 td:first-child{ font-size:17px; }
  /* gardiens */
  .gk-split{ margin-top:30px !important; }
  .gk-side h6{ font-size:34px; margin-bottom:16px; padding-bottom:12px; }
  .h6-logo{ height:38px; width:38px; vertical-align:-7px; }
  .gk-box2, .gk-compact .gk-box2{ padding:16px 18px; margin-bottom:16px; border-radius:18px; }
  .gk-box2 .nm, .gk-compact .gk-box2 .nm{ font-size:28px; margin-bottom:10px; }
  .gk-box2 .grid2, .gk-compact .gk-box2 .grid2{ gap:10px 12px; }
  .gk-box2 .grid2 div, .gk-compact .gk-box2 .grid2 div{ font-size:17px; }
  .gk-box2 .grid2 b, .gk-compact .gk-box2 .grid2 b{ font-size:21px; }
  .gk-box2 .relances, .gk-compact .gk-box2 .relances{ font-size:16px; margin-top:12px; padding-top:12px; line-height:1.4; }
  .gk-box2 .hc-grid, .gk-compact .gk-box2 .hc-grid{ gap:7px 12px; margin-top:12px; padding-top:12px; }
  .gk-box2 .hc-grid .hc-lab, .gk-compact .gk-box2 .hc-grid .hc-lab{ font-size:16px; }
  .gk-box2 .hc-grid div:not(.hc-lab), .gk-compact .gk-box2 .hc-grid div:not(.hc-lab){ font-size:15.5px; }
  .gk-box2 .hc-grid b, .gk-compact .gk-box2 .hc-grid b{ font-size:17px; }
{% endif %}
</style>
</head>
<body>
{%- macro pl(n, sing, plur) -%}{{ n }} {{ sing if (n|int) <= 1 else plur }}{%- endmacro -%}


<!-- PAGE 1 : COVER -->
<div class="card">
  <div class="kicker">RAPPORT DE MATCH - {{ journee | upper }} - {{ competition | upper }}</div>
  <hr class="rule">
  {% set lg = [affiche_a|length, affiche_b|length]|max %}
  {% set tsize = 50 if lg <= 8 else (40 if lg <= 10 else (34 if lg <= 12 else 28)) %}
  <div class="hero">
    <div class="team">
      <div class="logo-slot">{% if logo_a %}<img src="{{ logo_a }}">{% endif %}</div>
      <div class="tname" style="font-size:{{ tsize }}px;">{{ affiche_a }}</div>
    </div>
    <div class="team">
      <div class="logo-slot">{% if logo_b %}<img src="{{ logo_b }}">{% endif %}</div>
      <div class="tname" style="font-size:{{ tsize }}px;">{{ affiche_b }}</div>
    </div>
  </div>
  <div class="score-hero">
    <div class="half"><span class="digits">{{ score_a }}</span></div>
    <div class="half"><span class="digits">{{ score_b }}</span></div>
    <div class="sep"></div>
  </div>
  {% set ng = [buteurs_a|length, buteurs_b|length]|max %}
  <div class="scorers" style="font-size:{{ 22 if ng <= 4 else (18 if ng <= 6 else 15) }}px;">
    <div class="col">
      <div class="liste">
        <h6>BUTEURS {{ affiche_a }}</h6>
        {% for g in buteurs_a %}<div class="goal"><span class="min">{{ g.minute }}</span><span>{{ g.joueur }}</span></div>
        {% endfor %}
      </div>
    </div>
    <div class="col">
      <div class="liste">
        <h6>BUTEURS {{ affiche_b }}</h6>
        {% for g in buteurs_b %}<div class="goal"><span class="min">{{ g.minute }}</span><span>{{ g.joueur }}</span></div>
        {% endfor %}
      </div>
    </div>
  </div>
  <div class="byline">fait par Victor GEOFFROY</div>
  <div class="footer"><span class="cap">Un match de futsal raconté par la donnée</span><span class="pg">01</span></div>
</div>

<!-- PAGE 2 : STATS COLLECTIVES -->
<div class="card">
  <div class="kicker">STATISTIQUES COLLECTIVES</div>
  <hr class="rule">
  <h1 class="title" style="font-size:30px; margin-bottom:4px;">Le match, chiffre par chiffre</h1>
  <table class="stat-table">
    <tr class="eq"><td class="va"><span>{{ team_a }}</span>{% if logo_a %}<img src="{{ logo_a }}">{% endif %}</td><td></td><td class="vb"><span>{{ team_b }}</span>{% if logo_b %}<img src="{{ logo_b }}">{% endif %}</td></tr>
    {% for group in stat_groups %}
    <tr class="grp"><td colspan="3">{{ group.label }}</td></tr>
    {% for row in group.rows %}
    <tr><td class="va">{{ row.a }}</td><td class="lb">{{ row.label }}</td><td class="vb">{{ row.b }}</td></tr>
    {% endfor %}
    {% endfor %}
  </table>
  <div class="footer"><span class="cap">Toutes les stats collectives</span><span class="pg">02</span></div>
</div>

<!-- PAGE 3 : JOUEURS ÉQUIPE A -->
<div class="card">
  <div class="kicker">STATISTIQUES INDIVIDUELLES</div>
  <hr class="rule">
  <h1 class="title" style="font-size:30px;">{% if logo_a %}<img class="title-logo" src="{{ logo_a }}">{% endif %}La feuille de stats de {{ team_a }}</h1>
  <table class="pl2">
    <thead>
      <tr><th></th><th colspan="3">Tirs</th><th colspan="2">Duels</th><th colspan="4">Ballon</th><th>Discipline</th></tr>
      <tr><th>Joueurs</th><th>To.</th><th>Cad.</th><th>But</th><th>Off</th><th>Def</th><th>Perte</th><th>Récup</th><th>Inter</th><th>P.Loupé</th><th>F. Sub. / Com.</th></tr>
    </thead>
    <tbody>
      {% for p in joueurs_a %}
      <tr><td>{{ p.nom }}</td><td>{{ p.tirs }}</td><td>{{ p.tirs_cadres }}</td><td>{{ p.buts }}</td>
        <td>{{ p.duel_off_gagne }}/{{ p.duel_off_total }}</td><td>{{ p.duel_def_gagne }}/{{ p.duel_def_total }}</td>
        <td>{{ p.perte_balle }}</td><td>{{ p.recuperation }}</td><td>{{ p.interception }}</td><td>{{ p.passe_loupee }}</td><td>{{ p.faute_subie }} / {{ p.faute_commise }}</td></tr>
      {% endfor %}
    </tbody>
  </table>
  <div class="footer"><span class="cap">{{ pl(joueurs_a|length, 'joueur de champ', 'joueurs de champ') }} + {{ pl(gardiens_a|length, 'gardien', 'gardiens') }} (voir page gardiens)</span><span class="pg">03</span></div>
</div>

<!-- PAGE 4 : JOUEURS ÉQUIPE B -->
<div class="card">
  <div class="kicker">STATISTIQUES INDIVIDUELLES</div>
  <hr class="rule">
  <h1 class="title" style="font-size:30px;">{% if logo_b %}<img class="title-logo" src="{{ logo_b }}">{% endif %}La feuille de stats de {{ team_b }}</h1>
  <table class="pl2">
    <thead>
      <tr><th></th><th colspan="3">Tirs</th><th colspan="2">Duels</th><th colspan="4">Ballon</th><th>Discipline</th></tr>
      <tr><th>Joueurs</th><th>To.</th><th>Cad.</th><th>But</th><th>Off</th><th>Def</th><th>Perte</th><th>Récup</th><th>Inter</th><th>P.Loupé</th><th>F. Sub. / Com.</th></tr>
    </thead>
    <tbody>
      {% for p in joueurs_b %}
      <tr><td>{{ p.nom }}</td><td>{{ p.tirs }}</td><td>{{ p.tirs_cadres }}</td><td>{{ p.buts }}</td>
        <td>{{ p.duel_off_gagne }}/{{ p.duel_off_total }}</td><td>{{ p.duel_def_gagne }}/{{ p.duel_def_total }}</td>
        <td>{{ p.perte_balle }}</td><td>{{ p.recuperation }}</td><td>{{ p.interception }}</td><td>{{ p.passe_loupee }}</td><td>{{ p.faute_subie }} / {{ p.faute_commise }}</td></tr>
      {% endfor %}
    </tbody>
  </table>
  <div class="footer"><span class="cap">{{ pl(joueurs_b|length, 'joueur de champ', 'joueurs de champ') }} + {{ pl(gardiens_b|length, 'gardien', 'gardiens') }} (voir page gardiens)</span><span class="pg">{{ num_b }}</span></div>
</div>
<!-- PAGE 5 : GARDIENS -->
<div class="card{% if gardiens_a|length > 1 or gardiens_b|length > 1 %} gk-compact{% endif %}">
  <div class="kicker">STATISTIQUES INDIVIDUELLES</div>
  <hr class="rule">
  <h1 class="title" style="font-size:30px;">Les gardiens au révélateur</h1>
  <div class="gk-split" style="margin-top:10px;">
    <div class="gk-side a">
      <h6>{% if logo_a %}<img class="h6-logo" src="{{ logo_a }}">{% endif %}{{ team_a }}</h6>
      {% for gk in gardiens_a %}
      <div class="gk-box2">
        <div class="nm">{{ gk.nom }}</div>
        <div class="grid2">
          <div>Arrêts <b>{{ gk.arrets }}</b></div><div>Tirs subis <b>{{ gk.tirs_cadres_subis }}</b></div>
          <div>Buts subis <b>{{ gk.buts_subis }}</b></div><div>% Arrêts <b>{{ gk.pct_arrets }}%</b></div>
        </div>
        <div class="relances"><span class="lab">Relances</span>{{ pl(gk.relance_facile, 'facile', 'faciles') }} - {{ pl(gk.relance_diff_ok, 'difficile réussie', 'difficiles réussies') }}<br>{{ pl(gk.relance_diff_ko, 'difficile loupée', 'difficiles loupées') }}</div>
        <div class="hc-grid">
          <div class="hc-lab">Hors cage</div>
          <div>Tirs <b>{{ gk.tirs }}</b></div><div>Duels <b>{{ gk.duel_gagne }}/{{ gk.duel_total }}</b></div>
          <div>Perte <b>{{ gk.perte_balle }}</b></div><div>Récup <b>{{ gk.recuperation }}</b></div>
          <div>Inter <b>{{ gk.interception }}</b></div><div>P.Loupé <b>{{ gk.passe_loupee }}</b></div>
          <div>Faute S/C <b>{{ gk.faute_subie }}/{{ gk.faute_commise }}</b></div>
        </div>
      </div>
      {% endfor %}
    </div>
    <div class="gk-side b">
      <h6>{% if logo_b %}<img class="h6-logo" src="{{ logo_b }}">{% endif %}{{ team_b }}</h6>
      {% for gk in gardiens_b %}
      <div class="gk-box2">
        <div class="nm">{{ gk.nom }}</div>
        <div class="grid2">
          <div>Arrêts <b>{{ gk.arrets }}</b></div><div>Tirs subis <b>{{ gk.tirs_cadres_subis }}</b></div>
          <div>Buts subis <b>{{ gk.buts_subis }}</b></div><div>% Arrêts <b>{{ gk.pct_arrets }}%</b></div>
        </div>
        <div class="relances"><span class="lab">Relances</span>{{ pl(gk.relance_facile, 'facile', 'faciles') }} - {{ pl(gk.relance_diff_ok, 'difficile réussie', 'difficiles réussies') }}<br>{{ pl(gk.relance_diff_ko, 'difficile loupée', 'difficiles loupées') }}</div>
        <div class="hc-grid">
          <div class="hc-lab">Hors cage</div>
          <div>Tirs <b>{{ gk.tirs }}</b></div><div>Duels <b>{{ gk.duel_gagne }}/{{ gk.duel_total }}</b></div>
          <div>Perte <b>{{ gk.perte_balle }}</b></div><div>Récup <b>{{ gk.recuperation }}</b></div>
          <div>Inter <b>{{ gk.interception }}</b></div><div>P.Loupé <b>{{ gk.passe_loupee }}</b></div>
          <div>Faute S/C <b>{{ gk.faute_subie }}/{{ gk.faute_commise }}</b></div>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
  <div class="footer"><span class="cap">Les gardiens</span><span class="pg">{{ num_gk }}</span></div>
</div>

</div>

</body>
</html>
